# Environment variables for Decentralized Electricity Trading System

# =================== DJANGO SETTINGS ===================
DEBUG=True
SECRET_KEY=django-insecure-replace-with-your-secret-key-for-production
ALLOWED_HOSTS=127.0.0.1,localhost

# =================== DATABASE ===================
MYSQL_DB=decentralized_energy
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_HOST=localhost
MYSQL_PORT=3306

# =================== BLOCKCHAIN (Sepolia Testnet) ===================
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
PRIVATE_KEY=YOUR_METAMASK_PRIVATE_KEY_WITHOUT_0x
CONTRACT_ADDRESS=YOUR_DEPLOYED_TOKEN_CONTRACT_ADDRESS

# =================== JWT TOKENS ===================
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=your-jwt-secret-key

# =================== EMAIL (Optional) ===================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# =================== CORS SETTINGS ===================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =================== LOGGING ===================
LOG_LEVEL=INFO

# =================== MARKET SETTINGS ===================
MIN_ORDER_SIZE_KWH=0.1
MAX_ORDER_SIZE_KWH=1000
MIN_PRICE_PER_KWH=1
MAX_PRICE_PER_KWH=100
DEFAULT_ZONE=ZONE_A
